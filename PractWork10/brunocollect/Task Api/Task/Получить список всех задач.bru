meta {
  name: Получить список всех задач.
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/Task
  body: none
  auth: inherit
}

docs {
  ### Получение всех задач
  
  - **Метод:** `GET /api/Task`
  - **Описание:** Возвращает список всех задач.
  - **Пример запроса:**
  ```json
    GET /api/Task
  [
    {
      "id": 1,
      "name": "сделать круто",
      "description": "крутое задание",
      "endOfTask": "2026-10-01",
      "status": 0
    },
    {
      "id": 2,
      "name": "сделать не круто",
      "description": "не крутое задание",
      "endOfTask": "2025-09-12",
      "status": 1
    }
  ]
  ```
}

example {
  name: 200 Response
  description: Успешное выполнение
  
  request: {
    url: {{baseUrl}}/api/Task
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: text/plain
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
        [
          {
            "id": 0,
            "name": "",
            "description": "",
            "endOfTask": {
              "year": 0,
              "month": 0,
              "day": 0,
              "dayOfWeek": 0,
              "dayOfYear": 0,
              "dayNumber": 0
            },
            "status": 0
          }
        ]
      '''
    }
  }
}

