example {
  name: PostTaskNoContentResponse
  
  request: {
    url: {{baseUrl}}/api/Task
    method: POST
    mode: json
    body:json: {
        {
          "id": 1,
          "name": "сделать круто123123 топ",
          "description": " топовое и крутое задание",
          "endOfTask": "2026-10-01",
          "status": 1
        }
    }
  }
  
  response: {
    headers: {
      date: Tue, 16 Dec 2025 06:18:17 GMT
      server: Kestrel
    }
  
    status: {
      code: 204
      text: No Content
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
