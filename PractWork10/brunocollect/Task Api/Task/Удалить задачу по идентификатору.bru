meta {
  name: Удалить задачу по идентификатору.
  type: http
  seq: 5
}

delete {
  url: {{baseUrl}}/api/Task/:id
  body: none
  auth: inherit
}

params:path {
  id: 2
}

docs {
  ### 5. Удаление задачи по идентификатору
  - **Метод: DELETE /api/Task/{id}**
  - **Описание: Удаляет задачу по её уникальному идентификатору.**
  - **Пример запроса:**
  ```json
  DELETE /api/Task/7
  ```
}

